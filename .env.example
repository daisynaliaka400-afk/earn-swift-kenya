# --- Private keys (get the values from Lovable Project Settings -> Secrets) ---
# M-Pesa payment prompts (SmartPay)
SMARTPAY_API_KEY=
# Optional: override the SmartPay endpoint
# SMARTPAY_STK_ENDPOINT="https://api.smartpaypesa.com/v1/stk/push"

# SMS sending
SMS_API_TOKEN=
# Optional
# SMS_SENDER_ID="TOPSPEED"

# Server-only admin database key (required for payments, SMS, user deletion)
SUPABASE_SERVICE_ROLE_KEY=

# --- NOT available outside Lovable ---
# SUPABASE_SERVICE_ROLE_KEY is never exposed by Lovable Cloud.
# Without it, payment callbacks, SMS sending and admin user deletion
# will not work on Vercel/Netlify. Keep the live site on Lovable for full functionality.
